rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'mark@bateshollow.com';
    }
    match /users/{uid}/entries/{work} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['listened','rating','recording','notes'])
        && (!('listened' in request.resource.data) || request.resource.data.listened is bool)
        && (!('rating' in request.resource.data) || request.resource.data.rating in ['', '1', '2', '3', '4', '5'])
        && (!('recording' in request.resource.data) || (request.resource.data.recording is string && request.resource.data.recording.size() <= 20000))
        && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 100000));
    }
  }
}
